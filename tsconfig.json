{
    "compilerOptions": {
        "target": "es2020",
        "module": "commonjs",
        "allowJs": true,
        "checkJs": true,
        "resolveJsonModule": true,
        "noEmit": true,
        "strict": false,
        "skipLibCheck": true
    },
    "include": ["index.js", "lib/**/*.js"],
    "exclude": ["node_modules"]
}
